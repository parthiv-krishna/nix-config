+    fn take_dm_notice_recipient(&self, envelope: &Envelope, now: Instant) -> Option<String> {
+        if !self.group_only || !self.dm_unsupported_notice || envelope.story_message.is_some() {
+            return None;
+        }
+        let message = envelope.data_message.as_ref()?;
+        if message.group_info.is_some()
+            || !message
+                .message
+                .as_deref()
+                .is_some_and(|text| !text.trim().is_empty())
+        {
+            return None;
+        }
+        let sender = Self::sender(envelope)?;
+        if sender == self.account || !self.is_sender_allowed(&sender) {
+            return None;
+        }
+        let mut notices = self.dm_notice_times.lock();
+        if notices
+            .get(&sender)
+            .is_some_and(|last| now.duration_since(*last) < DM_NOTICE_INTERVAL)
+        {
+            return None;
+        }
+        notices.put(sender.clone(), now);
+        Some(sender)
+    }
