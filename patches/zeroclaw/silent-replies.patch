+    #[test]
+    fn silent_channel_final_response_accepts_only_quiet_markers() {
+        for response in [
+            "NO_REPLY",
+            "  no_reply\n",
+            "NO_REPLY[INFO]: unrelated group conversation",
+            " \nNO_REPLY[INFO]: nothing to add\n ",
+        ] {
+            assert!(is_silent_channel_final_response(response), "{response:?}");
+        }
+        for response in [
+            "",
+            "   ",
+            "NO_REPLYING",
+            "NO_REPLY[INFO]",
+            "NO_REPLY[INFO]:",
+            "NO_REPLY[FAIL]: request failed",
+            "NO_REPLY[REFUSE]: unsafe request",
+            "NO_REPLY: legacy classification",
+            "The classifier returned NO_REPLY",
+            "`NO_REPLY`",
+            "NO_REPLY[INFO]: nothing to add\nHere is an actual reply.",
+        ] {
+            assert!(!is_silent_channel_final_response(response), "{response:?}");
+        }
+    }
