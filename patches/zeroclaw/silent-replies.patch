+/// Recognize only a standalone quiet final response, never arbitrary prose
+/// containing a marker or a refusal/failure classification. Unlike the
+/// precheck parser, an empty response is not a silence instruction here.
+fn is_silent_channel_final_response(response: &str) -> bool {
+    let trimmed = response.trim();
+    if trimmed.eq_ignore_ascii_case("NO_REPLY") {
+        return true;
+    }
+    let Some(reason) = trimmed.strip_prefix("NO_REPLY[INFO]:") else {
+        return false;
+    };
+    let reason = reason.trim();
+    !reason.is_empty() && !reason.contains(['\n', '\r'])
+}
