+    #[tokio::test]
+    async fn silent_channel_final_response_is_not_delivered_after_precheck_bypass() {
+        let channel_impl = Arc::new(RecordingChannel::default());
+        let agent_cfg = zeroclaw_config::schema::AliasedAgentConfig {
+            precheck: zeroclaw_config::scattered_types::ChannelPrecheckConfig {
+                enabled: false,
+                ..Default::default()
+            },
+            ..Default::default()
+        };
+        let runtime_ctx = test_runtime_ctx_with_config_agent_and_provider_ref(
+            channel_impl.clone(),
+            Arc::new(NoReplyModelProvider),
+            zeroclaw_config::schema::Config::default(),
+            agent_cfg,
+            "test-provider",
+            None,
+        );
+        process_channel_message(
+            runtime_ctx,
+            zeroclaw_api::channel::ChannelMessage {
+                id: "msg-silent-final".to_string(),
+                sender: "alice".to_string(),
+                reply_target: "chat-silent-final".to_string(),
+                content: "background chatter".to_string(),
+                channel: "test-channel".into(),
+                timestamp: 1,
+                ..Default::default()
+            },
+            CancellationToken::new(),
+        )
+        .await;
+        assert!(channel_impl.sent_messages.lock().await.is_empty());
+        assert_eq!(channel_impl.final_send_calls.load(Ordering::SeqCst), 0);
+        assert!(!channel_impl
+            .reactions_added
+            .lock()
+            .await
+            .iter()
+            .any(|(_, _, emoji)| emoji == "\u{2705}"));
+        assert!(channel_impl
+            .reactions_removed
+            .lock()
+            .await
+            .iter()
+            .any(|(_, _, emoji)| emoji == "\u{1F440}"));
+    }
